	(text "In Series Coil Design:\nL_t = L_1 + L_2 + 2M\nM = k*sqrt(L_1*L_2)\nk = coupling coefficient (~0.9)\n\nQ = wL/R\nResistance doubles, Inductance approximately quadruple\nQ = w*2L(1+k)/2R\n\nVoltage Rating on C\nV_cap = Q*V_drive\n\nL_t = 380 uH\n\n"
		(exclude_from_sim no)
		(at 298.958 51.816 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "da6c9982-3af6-4ad1-a07e-66fe5459afdc")
	)
