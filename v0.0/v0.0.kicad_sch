	(text "Q = sqrt(L/C)/R = Z_0/R\n\nAt resonance, reactance of of L and C are the same (imaginary part of impedance).\nX_l = X_c\n\nQuality factor directly affected by resistance, PCB copper traces is very thing\n-> Only 2D\n-> No ferrite (ferrite increase the inductance)\n-> Proximity effect?\n-> R = pl/S (S=W*t)"
		(exclude_from_sim no)
		(at 299.212 25.146 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "28236c66-c616-4610-b73f-7c73d99a6a03")
	)
	(text "Disable the boost while USB is in"
		(exclude_from_sim no)
